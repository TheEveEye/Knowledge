#!/bin/zsh
set -euo pipefail
SCRIPT_DIR="${0:A:h}"
for recall_node in "${RECALL_NODE_BIN:-}" "/opt/homebrew/opt/node@24/bin/node" "$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node" "$(command -v node || true)"; do
  if [[ -n "$recall_node" && -x "$recall_node" && "$($recall_node -p 'process.versions.node.split(".")[0]')" == 24 ]]; then
    exec "$recall_node" "$SCRIPT_DIR/src/cli.mjs" "$@"
  fi
done
print -u2 'Node.js 24 is required. Install it or set RECALL_NODE_BIN to its executable.'
exit 1
