{
  "name": "knowledge",
  "private": true,
  "workspaces": ["apps/api"],
  "engines": { "node": ">=24 <25" },
  "overrides": {
    "@esbuild-kit/core-utils": { "esbuild": "0.25.12" }
  },
  "scripts": {
    "build": "npm run build --workspace @knowledge/api",
    "typecheck": "npm run typecheck --workspace @knowledge/api",
    "dev": "npm run dev --workspace @knowledge/api",
    "db:generate": "npm run db:generate --workspace @knowledge/api --",
    "dev:up": "bash infra/scripts/dev.sh up",
    "dev:down": "bash infra/scripts/dev.sh down",
    "dev:logs": "bash infra/scripts/dev.sh logs"
  }
}
