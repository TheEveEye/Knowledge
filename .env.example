KNOWLEDGE_API_IMAGE=knowledge-api:development
KNOWLEDGE_SECRETS_DIR=./.secrets
KNOWLEDGE_HTTP_PORT=8088
APP_REVISION=development
LOG_LEVEL=info
AUTH_BASE_URL=http://127.0.0.1:8088
AUTH_TRUSTED_ORIGINS=
AUTH_TRUST_CLOUDFLARE=false
CHATGPT_SELF_HOSTED_ENABLED=true
WORKER_CONCURRENCY=2
